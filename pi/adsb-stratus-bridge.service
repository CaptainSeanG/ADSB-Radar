[Unit]
Description=ADS-B Radar Stratus bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-/etc/default/adsb-radar
ExecStart=/usr/bin/npm run stratus
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
